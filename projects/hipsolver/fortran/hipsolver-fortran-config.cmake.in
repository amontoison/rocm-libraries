# Config package for the hipSOLVER Fortran bindings.
#
#   find_package(hipsolver-fortran REQUIRED)
#   target_link_libraries(my_app PRIVATE roc::hipsolver_fortran)
#
# The bindings ship as one archive and one .mod set PER FORTRAN COMPILER, since a
# .mod is not portable across compilers. This package checks that the consumer is
# building with the compiler the bindings were installed for, and fails with a
# named diagnostic rather than hitting an unreadable .mod much later.

@PACKAGE_INIT@

set(HIPSOLVER_FORTRAN_COMPILER_DIR "@HIPSOLVER_FORTRAN_COMPILER_DIR@")

# Where the per-compiler subdirectories live. Written by PATH_VARS, so the
# preamble above has already turned each into an absolute path derived from where
# THIS file was found: relocatable, and lib64 where a distro uses it. Everything
# below goes through these two.
#
# Do not spell the preamble's token here: configure_package_config_file()
# substitutes it everywhere in the template, comments included.
set(_hipsolver_libdir "@PACKAGE_HIPSOLVER_FORTRAN_LIBDIR@")
set(_hipsolver_incdir "@PACKAGE_HIPSOLVER_FORTRAN_INCLUDEDIR@")

# A consumer asks "is a hipSOLVER Fortran binding available here?" through
# hipsolver_FORTRAN_FOUND, set by this package whether it is reached through
# lib/cmake/hipsolver or the hipsolver-fortran forwarder; it is installed beside
# the C hipsolver-config.cmake so one CMAKE_PREFIX_PATH entry finds both. It
# stays FALSE on every early return below.
set(hipsolver_FORTRAN_FOUND FALSE)

if(NOT CMAKE_Fortran_COMPILER_LOADED)
  set(hipsolver-fortran_FOUND FALSE)
  # string(CONCAT), not a multi-argument set(): that builds a LIST, and
  # find_package renders a list with a semicolon at every element boundary, so a
  # message split across lines for readability comes out as
  # "... find_package: ;add Fortran to ...".
  string(CONCAT hipsolver-fortran_NOT_FOUND_MESSAGE
      "The hipSOLVER Fortran bindings need Fortran enabled before find_package: "
      "add Fortran to your project() languages, or call enable_language(Fortran).")
  return()
endif()

# MUST mirror the mapping in projects/hipsolver/fortran/CMakeLists.txt exactly:
# it recomputes, for the CONSUMER's compiler, the directory name the bindings
# were installed under. The two cannot share code -- this file runs in a
# consumer's build long after ours is gone -- so they are kept in step by hand.
# Get it wrong and the check never matches, rejecting every consumer with a
# compiler mismatch that does not exist.
if(CMAKE_Fortran_COMPILER_ID STREQUAL "GNU")
  set(_hipsolver_fc "gfortran")
elseif(CMAKE_Fortran_COMPILER_ID MATCHES "Flang")
  set(_hipsolver_fc "amdflang")
elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "Cray")
  set(_hipsolver_fc "ftn")
elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "IntelLLVM")
  set(_hipsolver_fc "ifx")
elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "Intel")
  set(_hipsolver_fc "ifort")
elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "NVHPC")
  set(_hipsolver_fc "nvfortran")
else()
  get_filename_component(_hipsolver_fc "${CMAKE_Fortran_COMPILER}" NAME_WE)
  string(TOLOWER "${_hipsolver_fc}" _hipsolver_fc)
endif()

# A site that installs several versions of one compiler overrides
# HIPSOLVER_FORTRAN_COMPILER_DIR with a suffixed name (gfortran-13.3.0), so
# accept the derived name, or that name followed by a separator and anything; a
# strict equality would reject exactly the sites that used the documented
# override. The layout records no version, so this cannot tell gfortran 13 from
# gfortran 15.
#
# By length and substring rather than regex: _hipsolver_fc can be an arbitrary
# file name from the fallback branch above, and CMake has no regex-escape, so a
# compiler called g++.wrapper or flang(2) would mismatch or abort the regex.
function(_hipsolver_dir_matches DIR FC OUT)
  set(${OUT} FALSE PARENT_SCOPE)
  if(DIR STREQUAL FC)
    set(${OUT} TRUE PARENT_SCOPE)
    return()
  endif()
  string(LENGTH "${FC}" _n)
  string(LENGTH "${DIR}" _dn)
  if(_dn GREATER _n)
    string(SUBSTRING "${DIR}" 0 ${_n} _head)
    string(SUBSTRING "${DIR}" ${_n} 1 _sep)
    if(_head STREQUAL FC AND _sep MATCHES "^[-._]$")
      set(${OUT} TRUE PARENT_SCOPE)
    endif()
  endif()
endfunction()

# Which per-compiler directory to use. The recorded
# HIPSOLVER_FORTRAN_COMPILER_DIR is only a default: a prefix can hold artifacts
# for several compilers, but the config package is written once, so the recorded
# value names whichever install ran last and trusting it blindly would reject a
# consumer whose .mod is present. Prefer the consumer's OWN compiler when its
# artifacts are installed here, and fall back to the recorded directory.
set(_hipsolver_dir "")
if(EXISTS "${_hipsolver_incdir}/${_hipsolver_fc}/hipsolver.mod")
  set(_hipsolver_dir "${_hipsolver_fc}")
else()
  _hipsolver_dir_matches("${HIPSOLVER_FORTRAN_COMPILER_DIR}" "${_hipsolver_fc}" _hipsolver_ok)
  if(_hipsolver_ok)
    set(_hipsolver_dir "${HIPSOLVER_FORTRAN_COMPILER_DIR}")
  endif()
endif()

if(NOT _hipsolver_dir)
  # Name what IS installed, so the reader can see whether they need to rebuild
  # or merely point at an existing directory.
  file(GLOB _hipsolver_avail RELATIVE "${_hipsolver_incdir}"
       "${_hipsolver_incdir}/*")
  set(hipsolver-fortran_FOUND FALSE)
  string(CONCAT hipsolver-fortran_NOT_FOUND_MESSAGE
      "This project builds with ${_hipsolver_fc}, but no hipsolver.mod for it is "
      "installed under ${_hipsolver_incdir}. Available: "
      "${_hipsolver_avail}. A Fortran .mod cannot be shared across compilers; "
      "rebuild the bindings with ${_hipsolver_fc}, or set "
      "HIPSOLVER_FORTRAN_COMPILER_DIR to the directory to use.")
  return()
endif()

# The C library the binding declares bind(C) interfaces into. A link-time
# dependency of the imported target, so it must be imported BEFORE the include()
# below or roc::hipsolver_fortran would point at an undefined roc::hipsolver and
# the generate step would fail.
#
# The outer condition is interpolated to a literal TRUE or FALSE by the build
# that installed this file, and records whether roc::hipsolver really is in the
# exported link interface: the bindings can be built with no hipSOLVER installed,
# and demanding the C package here would then fail for a dependency this package
# does not have.
#
# hipsolver-config.cmake does find_dependency(HIP), and hip-config.cmake reaches
# FindThreads, which hard-errors unless C or CXX is enabled. Enabling a language
# from a config package is unusual and deliberate: the alternative is every
# Fortran consumer writing enable_language(C) after an error naming nothing they
# wrote.
if(@HIPSOLVER_FORTRAN_NEEDS_C_PACKAGE@)
  if(NOT TARGET roc::hipsolver)
    if(NOT CMAKE_C_COMPILER_LOADED AND NOT CMAKE_CXX_COMPILER_LOADED)
      enable_language(C)
    endif()
    include(CMakeFindDependencyMacro)
    find_dependency(hipsolver)
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/hipsolver-fortran-targets.cmake")

# The targets file hardcodes the directory the package was BUILT with. When the
# consumer's compiler resolved to a different one above, repoint the imported
# target at it, otherwise the .mod found and the archive linked would disagree.
if(NOT _hipsolver_dir STREQUAL "${HIPSOLVER_FORTRAN_COMPILER_DIR}")
  set_target_properties(roc::hipsolver_fortran PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${_hipsolver_incdir}/${_hipsolver_dir}")
  get_target_property(_hipsolver_cfgs roc::hipsolver_fortran IMPORTED_CONFIGURATIONS)
  foreach(_hipsolver_c IN LISTS _hipsolver_cfgs)
    set_target_properties(roc::hipsolver_fortran PROPERTIES
      IMPORTED_LOCATION_${_hipsolver_c}
        "${_hipsolver_libdir}/${_hipsolver_dir}/libhipsolver_fortran.a")
  endforeach()
endif()

set(hipsolver_FORTRAN_FOUND TRUE)

check_required_components(hipsolver-fortran)
