# Config package for the hipFFT Fortran bindings.
#
#   find_package(hipfft-fortran REQUIRED)
#   target_link_libraries(my_app PRIVATE hip::hipfft_fortran)
#
# This file installs into lib/cmake/hipfft, beside hipfft-config.cmake, so that
# one CMAKE_PREFIX_PATH entry finds both. CMake's own search for
# find_package(hipfft-fortran) globs lib/cmake/hipfft-fortran*, which that
# directory does not match, so a one-line forwarder is installed there and
# includes this file.
#
# The bindings ship as one archive and one .mod set PER FORTRAN COMPILER, since a
# .mod is not portable across compilers. This package checks that the consumer is
# building with the compiler the bindings were installed for, and fails with a
# named diagnostic rather than hitting an unreadable .mod much later.

@PACKAGE_INIT@

set(HIPFFT_FORTRAN_COMPILER_DIR "@HIPFFT_FORTRAN_COMPILER_DIR@")

# Where the per-compiler subdirectories live. Written by PATH_VARS, so the
# preamble above has already turned each into an absolute path derived from where
# THIS file was found: relocatable, and lib64 where a distro uses it. Everything
# below goes through these two.
#
# Do not spell the preamble's token here: configure_package_config_file()
# substitutes it everywhere in the template, comments included.
set(_hipfft_libdir "@PACKAGE_HIPFFT_FORTRAN_LIBDIR@")
set(_hipfft_incdir "@PACKAGE_HIPFFT_FORTRAN_INCLUDEDIR@")

# A consumer asks "is a hipFFT Fortran binding available here?" through
# hipfft_FORTRAN_FOUND, which find_package(hipfft-fortran) sets. It stays FALSE
# on every early return below.
set(hipfft_FORTRAN_FOUND FALSE)

# string(CONCAT), not a multi-argument set(): that builds a LIST, and CMake then
# prints the message with semicolons between the pieces.
if(NOT CMAKE_Fortran_COMPILER_LOADED)
  set(hipfft-fortran_FOUND FALSE)
  string(CONCAT hipfft-fortran_NOT_FOUND_MESSAGE
      "The hipFFT Fortran bindings need Fortran enabled before find_package: "
      "add Fortran to your project() languages, or call enable_language(Fortran).")
  return()
endif()

# THIS MAPPING MUST MIRROR the one in projects/hipfft/fortran/CMakeLists.txt
# exactly: it recomputes, for the CONSUMER's compiler, the directory name the
# bindings were installed under. The two cannot share code -- this file runs in a
# consumer's build long after ours is gone -- so they are kept in step by hand.
# Get it wrong and the check never matches, rejecting every consumer with a
# compiler mismatch that does not exist.
#
# Compared on the compiler EXECUTABLE name, which is what the install layout is
# keyed on; the ID would not do, being "GNU" where the directory is "gfortran".
# Derived from the ID and mapped back, NOT taken as the basename of
# CMAKE_Fortran_COMPILER, so that a consumer building through an MPI wrapper
# (mpif90), a versioned binary (gfortran-13) or the Cray wrapper compares equal
# to the directory the bindings really installed under.
if(CMAKE_Fortran_COMPILER_ID STREQUAL "GNU")
  set(_hipfft_fc "gfortran")
elseif(CMAKE_Fortran_COMPILER_ID MATCHES "Flang")     # Flang, LLVMFlang
  set(_hipfft_fc "amdflang")
elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "Cray")
  set(_hipfft_fc "ftn")
elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "IntelLLVM")
  set(_hipfft_fc "ifx")
elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "Intel")
  set(_hipfft_fc "ifort")
elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "NVHPC")
  set(_hipfft_fc "nvfortran")
else()
  get_filename_component(_hipfft_fc "${CMAKE_Fortran_COMPILER}" NAME_WE)
  string(TOLOWER "${_hipfft_fc}" _hipfft_fc)
endif()

# A site that installs several versions of one compiler overrides
# HIPFFT_FORTRAN_COMPILER_DIR with a suffixed name (gfortran-13.3.0), so accept
# the derived name, or that name followed by a separator and anything; a strict
# equality would reject exactly the sites that used the documented override. The
# layout records no version, so this cannot tell gfortran 13 from gfortran 15.
#
# By length and substring rather than regex: _hipfft_fc can be an arbitrary file
# name from the fallback branch above, and CMake has no regex-escape, so a
# compiler called g++.wrapper or flang(2) would mismatch or abort the regex.
#
# Named _hipfft_ and not _fortran_: hipfftw-fortran-config.cmake carries the same
# helper under _hipfftw_, and a consumer that finds both packages would otherwise
# redefine one function with the other's body.
function(_hipfft_dir_matches DIR FC OUT)
  set(${OUT} FALSE PARENT_SCOPE)
  if(DIR STREQUAL FC)
    set(${OUT} TRUE PARENT_SCOPE)
    return()
  endif()
  string(LENGTH "${FC}" _n)
  string(LENGTH "${DIR}" _dn)
  if(_dn GREATER _n)
    string(SUBSTRING "${DIR}" 0 ${_n} _head)
    string(SUBSTRING "${DIR}" ${_n} 1 _sep)
    if(_head STREQUAL FC AND _sep MATCHES "^[-._]$")
      set(${OUT} TRUE PARENT_SCOPE)
    endif()
  endif()
endfunction()

# Which per-compiler directory to use. The recorded HIPFFT_FORTRAN_COMPILER_DIR
# is only a default: a prefix can hold artifacts for several compilers, but the
# config package is written once, so the recorded value names whichever install
# ran last and trusting it blindly would reject a consumer whose .mod is present.
# Prefer the consumer's OWN compiler when its artifacts are installed here.
# hipfft.mod and not just the directory: either half is switchable on its own, so
# a directory that exists proves nothing about THIS binding.
set(_hipfft_dir "")
if(EXISTS "${_hipfft_incdir}/${_hipfft_fc}/hipfft.mod")
  set(_hipfft_dir "${_hipfft_fc}")
else()
  _hipfft_dir_matches("${HIPFFT_FORTRAN_COMPILER_DIR}" "${_hipfft_fc}" _hipfft_ok)
  if(_hipfft_ok)
    set(_hipfft_dir "${HIPFFT_FORTRAN_COMPILER_DIR}")
  endif()
endif()

if(NOT _hipfft_dir)
  # Name what IS installed, so the reader can see whether they need to rebuild
  # or merely point at an existing directory.
  file(GLOB _hipfft_avail RELATIVE "${_hipfft_incdir}"
       "${_hipfft_incdir}/*")
  set(hipfft-fortran_FOUND FALSE)
  string(CONCAT hipfft-fortran_NOT_FOUND_MESSAGE
      "This project builds with ${_hipfft_fc}, but no hipfft.mod for it is "
      "installed under ${_hipfft_incdir}. Available: "
      "${_hipfft_avail}. A Fortran .mod cannot be shared across compilers; "
      "rebuild the bindings with ${_hipfft_fc}, or set "
      "HIPFFT_FORTRAN_COMPILER_DIR to the directory to use.")
  return()
endif()

# hipfft-fortran-targets.cmake names hip::hipfft in its link interface, so that
# target MUST exist BEFORE the targets file is read, or CMake stops with "the
# link interface of target hip::hipfft_fortran contains: hip::hipfft but the
# target was not found", which reads like a packaging bug.
#
# hipfft-config.cmake find_dependency(hip)s, and hip-config-amd.cmake reaches
# FindThreads, which hard-errors unless C or CXX is enabled. Enabling a language
# from a config package is unusual and deliberate: the alternative is every
# Fortran consumer writing enable_language(C) for a reason that has nothing to do
# with their code.
#
# The interpolated flag is FALSE only for a bindings-only install made with no
# hipFFT in sight, where the exported target carries no link interface and the
# consumer supplies -lhipfft itself.
if(@HIPFFT_FORTRAN_NEEDS_HIPFFT_PACKAGE@ AND NOT TARGET hip::hipfft)
  if(NOT CMAKE_C_COMPILER_LOADED AND NOT CMAKE_CXX_COMPILER_LOADED)
    enable_language(C)
  endif()
  include(CMakeFindDependencyMacro)
  find_dependency(hipfft)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/hipfft-fortran-targets.cmake")

# The targets file hardcodes the directory the package was BUILT with. When the
# consumer's compiler resolved to a different one above, repoint the imported
# target at it, otherwise the .mod found and the archive linked would disagree.
if(NOT _hipfft_dir STREQUAL "${HIPFFT_FORTRAN_COMPILER_DIR}")
  set_target_properties(hip::hipfft_fortran PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${_hipfft_incdir}/${_hipfft_dir}")
  get_target_property(_hipfft_cfgs hip::hipfft_fortran IMPORTED_CONFIGURATIONS)
  foreach(_hipfft_c IN LISTS _hipfft_cfgs)
    set_target_properties(hip::hipfft_fortran PROPERTIES
      IMPORTED_LOCATION_${_hipfft_c}
        "${_hipfft_libdir}/${_hipfft_dir}/libhipfft_fortran.a")
  endforeach()
endif()

set(hipfft_FORTRAN_FOUND TRUE)

check_required_components(hipfft-fortran)
