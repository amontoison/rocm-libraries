# Config package for the hipFFT Fortran bindings:
#   find_package(hipfft-fortran REQUIRED)
#   target_link_libraries(my_app PRIVATE hip::hipfft_fortran)
# Set HIPFFT_FORTRAN_COMPILER_DIR to pick the per-compiler directory yourself.

@PACKAGE_INIT@

set(_hipfft_built_dir "@HIPFFT_FORTRAN_COMPILER_DIR@")

# Do not spell the preamble's token in this file: it is substituted everywhere.
set(_hipfft_libdir "@PACKAGE_HIPFFT_FORTRAN_LIBDIR@")
set(_hipfft_incdir "@PACKAGE_HIPFFT_FORTRAN_INCLUDEDIR@")

set(hipfft_FORTRAN_FOUND FALSE)

if(NOT CMAKE_Fortran_COMPILER_LOADED)
  set(hipfft-fortran_FOUND FALSE)
  string(CONCAT hipfft-fortran_NOT_FOUND_MESSAGE
      "The hipFFT Fortran bindings need Fortran enabled before find_package: "
      "add Fortran to your project() languages, or call enable_language(Fortran).")
  return()
endif()

if(DEFINED HIPFFT_FORTRAN_COMPILER_DIR)
  # The consumer chose the directory: use exactly that one.
  set(_hipfft_dir "${HIPFFT_FORTRAN_COMPILER_DIR}")
  if(NOT EXISTS "${_hipfft_incdir}/${_hipfft_dir}/hipfft.mod")
    file(GLOB _hipfft_avail RELATIVE "${_hipfft_incdir}"
         "${_hipfft_incdir}/*")
    set(hipfft-fortran_FOUND FALSE)
    string(CONCAT hipfft-fortran_NOT_FOUND_MESSAGE
        "HIPFFT_FORTRAN_COMPILER_DIR is '${_hipfft_dir}', but there is no "
        "${_hipfft_incdir}/${_hipfft_dir}/hipfft.mod. Available: "
        "${_hipfft_avail}.")
    return()
  endif()
else()
  # MUST match the mapping in projects/hipfft/fortran/CMakeLists.txt.
  if(CMAKE_Fortran_COMPILER_ID STREQUAL "GNU")
    set(_hipfft_fc "gfortran")
  elseif(CMAKE_Fortran_COMPILER_ID MATCHES "Flang")     # Flang, LLVMFlang
    set(_hipfft_fc "amdflang")
  elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "Cray")
    set(_hipfft_fc "ftn")
  elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "IntelLLVM")
    set(_hipfft_fc "ifx")
  elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "Intel")
    set(_hipfft_fc "ifort")
  elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "NVHPC")
    set(_hipfft_fc "nvfortran")
  else()
    get_filename_component(_hipfft_fc "${CMAKE_Fortran_COMPILER}" NAME_WE)
    string(TOLOWER "${_hipfft_fc}" _hipfft_fc)
  endif()

  # Accepts FC or FC<sep>suffix (e.g. gfortran-13.3.0). Not a regex: FC can be
  # an arbitrary file name and CMake has no regex-escape. Prefixed per package
  # because hipfft- and hipfftw-fortran-config.cmake are often loaded together.
  function(_hipfft_dir_matches DIR FC OUT)
    set(${OUT} FALSE PARENT_SCOPE)
    if(DIR STREQUAL FC)
      set(${OUT} TRUE PARENT_SCOPE)
      return()
    endif()
    string(LENGTH "${FC}" _n)
    string(LENGTH "${DIR}" _dn)
    if(_dn GREATER _n)
      string(SUBSTRING "${DIR}" 0 ${_n} _head)
      string(SUBSTRING "${DIR}" ${_n} 1 _sep)
      if(_head STREQUAL FC AND _sep MATCHES "^[-._]$")
        set(${OUT} TRUE PARENT_SCOPE)
      endif()
    endif()
  endfunction()

  # Prefer the consumer's own compiler; the built directory is only a fallback.
  # Checked on hipfft.mod: the two bindings are switchable independently.
  set(_hipfft_dir "")
  if(EXISTS "${_hipfft_incdir}/${_hipfft_fc}/hipfft.mod")
    set(_hipfft_dir "${_hipfft_fc}")
  else()
    _hipfft_dir_matches("${_hipfft_built_dir}" "${_hipfft_fc}" _hipfft_ok)
    if(_hipfft_ok)
      set(_hipfft_dir "${_hipfft_built_dir}")
    endif()
  endif()

  if(NOT _hipfft_dir)
    file(GLOB _hipfft_avail RELATIVE "${_hipfft_incdir}"
         "${_hipfft_incdir}/*")
    set(hipfft-fortran_FOUND FALSE)
    string(CONCAT hipfft-fortran_NOT_FOUND_MESSAGE
        "This project builds with ${_hipfft_fc}, but no hipfft.mod for it is "
        "installed under ${_hipfft_incdir}. Available: "
        "${_hipfft_avail}. A Fortran .mod cannot be shared across compilers; "
        "rebuild the bindings with ${_hipfft_fc}, or set "
        "HIPFFT_FORTRAN_COMPILER_DIR to the directory to use.")
    return()
  endif()
endif()

# hip::hipfft must exist before the targets file is read. C is enabled because
# hip-config-amd.cmake reaches FindThreads.
if(@HIPFFT_FORTRAN_NEEDS_HIPFFT_PACKAGE@ AND NOT TARGET hip::hipfft)
  if(NOT CMAKE_C_COMPILER_LOADED AND NOT CMAKE_CXX_COMPILER_LOADED)
    enable_language(C)
  endif()
  include(CMakeFindDependencyMacro)
  find_dependency(hipfft)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/hipfft-fortran-targets.cmake")

# The targets file hardcodes the built directory; repoint it if another was chosen.
if(NOT _hipfft_dir STREQUAL "${_hipfft_built_dir}")
  set_target_properties(hip::hipfft_fortran PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${_hipfft_incdir}/${_hipfft_dir}")
  get_target_property(_hipfft_cfgs hip::hipfft_fortran IMPORTED_CONFIGURATIONS)
  foreach(_hipfft_c IN LISTS _hipfft_cfgs)
    set_target_properties(hip::hipfft_fortran PROPERTIES
      IMPORTED_LOCATION_${_hipfft_c}
        "${_hipfft_libdir}/${_hipfft_dir}/libhipfft_fortran.a")
  endforeach()
endif()

set(hipfft_FORTRAN_FOUND TRUE)

check_required_components(hipfft-fortran)
