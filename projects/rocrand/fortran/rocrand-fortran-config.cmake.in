# Config package for the rocRAND Fortran bindings:
#   find_package(rocrand-fortran REQUIRED)
#   target_link_libraries(my_app PRIVATE roc::rocrand_fortran)
# Set ROCRAND_FORTRAN_COMPILER_DIR to pick the per-compiler directory yourself.

@PACKAGE_INIT@

set(_rocrand_built_dir "@ROCRAND_FORTRAN_COMPILER_DIR@")

# Do not spell the preamble's token in this file: it is substituted everywhere.
set(_rocrand_libdir "@PACKAGE_ROCRAND_FORTRAN_LIBDIR@")
set(_rocrand_incdir "@PACKAGE_ROCRAND_FORTRAN_INCLUDEDIR@")

set(rocrand_FORTRAN_FOUND FALSE)

if(NOT CMAKE_Fortran_COMPILER_LOADED)
  set(rocrand-fortran_FOUND FALSE)
  string(CONCAT rocrand-fortran_NOT_FOUND_MESSAGE
      "The rocRAND Fortran bindings need Fortran enabled before find_package: "
      "add Fortran to your project() languages, or call enable_language(Fortran).")
  return()
endif()

if(DEFINED ROCRAND_FORTRAN_COMPILER_DIR)
  # The consumer chose the directory: use exactly that one.
  set(_rocrand_dir "${ROCRAND_FORTRAN_COMPILER_DIR}")
  if(NOT EXISTS "${_rocrand_incdir}/${_rocrand_dir}/rocrand.mod")
    file(GLOB _rocrand_avail RELATIVE "${_rocrand_incdir}"
         "${_rocrand_incdir}/*")
    set(rocrand-fortran_FOUND FALSE)
    string(CONCAT rocrand-fortran_NOT_FOUND_MESSAGE
        "ROCRAND_FORTRAN_COMPILER_DIR is '${_rocrand_dir}', but there is no "
        "${_rocrand_incdir}/${_rocrand_dir}/rocrand.mod. Available: "
        "${_rocrand_avail}.")
    return()
  endif()
else()
  # MUST match the mapping in projects/rocrand/fortran/CMakeLists.txt.
  if(CMAKE_Fortran_COMPILER_ID STREQUAL "GNU")
    set(_rocrand_fc "gfortran")
  elseif(CMAKE_Fortran_COMPILER_ID MATCHES "Flang")
    set(_rocrand_fc "amdflang")
  elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "Cray")
    set(_rocrand_fc "ftn")
  elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "IntelLLVM")
    set(_rocrand_fc "ifx")
  elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "Intel")
    set(_rocrand_fc "ifort")
  elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "NVHPC")
    set(_rocrand_fc "nvfortran")
  else()
    get_filename_component(_rocrand_fc "${CMAKE_Fortran_COMPILER}" NAME_WE)
    string(TOLOWER "${_rocrand_fc}" _rocrand_fc)
  endif()

  # Accepts FC or FC<sep>suffix (e.g. gfortran-13.3.0). Not a regex: FC can be
  # an arbitrary file name and CMake has no regex-escape.
  function(_rocrand_dir_matches DIR FC OUT)
    set(${OUT} FALSE PARENT_SCOPE)
    if(DIR STREQUAL FC)
      set(${OUT} TRUE PARENT_SCOPE)
      return()
    endif()
    string(LENGTH "${FC}" _n)
    string(LENGTH "${DIR}" _dn)
    if(_dn GREATER _n)
      string(SUBSTRING "${DIR}" 0 ${_n} _head)
      string(SUBSTRING "${DIR}" ${_n} 1 _sep)
      if(_head STREQUAL FC AND _sep MATCHES "^[-._]$")
        set(${OUT} TRUE PARENT_SCOPE)
      endif()
    endif()
  endfunction()

  # Prefer the consumer's own compiler; the built directory is only a fallback.
  set(_rocrand_dir "")
  if(EXISTS "${_rocrand_incdir}/${_rocrand_fc}/rocrand.mod")
    set(_rocrand_dir "${_rocrand_fc}")
  else()
    _rocrand_dir_matches("${_rocrand_built_dir}" "${_rocrand_fc}" _rocrand_ok)
    if(_rocrand_ok)
      set(_rocrand_dir "${_rocrand_built_dir}")
    endif()
  endif()

  if(NOT _rocrand_dir)
    file(GLOB _rocrand_avail RELATIVE "${_rocrand_incdir}"
         "${_rocrand_incdir}/*")
    set(rocrand-fortran_FOUND FALSE)
    string(CONCAT rocrand-fortran_NOT_FOUND_MESSAGE
        "This project builds with ${_rocrand_fc}, but no rocrand.mod for it is "
        "installed under ${_rocrand_incdir}. Available: "
        "${_rocrand_avail}. A Fortran .mod cannot be shared across compilers; "
        "rebuild the bindings with ${_rocrand_fc}, or set "
        "ROCRAND_FORTRAN_COMPILER_DIR to the directory to use.")
    return()
  endif()
endif()

# roc::rocrand must exist before the targets file is read. C is enabled because
# hip-config.cmake reaches FindThreads.
if(@ROCRAND_FORTRAN_NEEDS_C_PACKAGE@)
  if(NOT TARGET roc::rocrand)
    if(NOT CMAKE_C_COMPILER_LOADED AND NOT CMAKE_CXX_COMPILER_LOADED)
      enable_language(C)
    endif()
    include(CMakeFindDependencyMacro)
    find_dependency(rocrand)
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/rocrand-fortran-targets.cmake")

# The targets file hardcodes the built directory; repoint it if another was chosen.
if(NOT _rocrand_dir STREQUAL "${_rocrand_built_dir}")
  set_target_properties(roc::rocrand_fortran PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${_rocrand_incdir}/${_rocrand_dir}")
  get_target_property(_rocrand_cfgs roc::rocrand_fortran IMPORTED_CONFIGURATIONS)
  foreach(_rocrand_c IN LISTS _rocrand_cfgs)
    set_target_properties(roc::rocrand_fortran PROPERTIES
      IMPORTED_LOCATION_${_rocrand_c}
        "${_rocrand_libdir}/${_rocrand_dir}/librocrand_fortran.a")
  endforeach()
endif()

set(rocrand_FORTRAN_FOUND TRUE)

check_required_components(rocrand-fortran)
