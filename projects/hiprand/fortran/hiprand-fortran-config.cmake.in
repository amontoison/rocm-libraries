# Config package for the hipRAND Fortran bindings:
#   find_package(hiprand-fortran REQUIRED)
#   target_link_libraries(my_app PRIVATE hip::hiprand_fortran)
# Set HIPRAND_FORTRAN_COMPILER_DIR to pick the per-compiler directory yourself.

@PACKAGE_INIT@

set(_hiprand_built_dir "@HIPRAND_FORTRAN_COMPILER_DIR@")

# Do not spell the preamble's token in this file: it is substituted everywhere.
set(_hiprand_libdir "@PACKAGE_HIPRAND_FORTRAN_LIBDIR@")
set(_hiprand_incdir "@PACKAGE_HIPRAND_FORTRAN_INCLUDEDIR@")

set(hiprand_FORTRAN_FOUND FALSE)

if(NOT CMAKE_Fortran_COMPILER_LOADED)
  set(hiprand-fortran_FOUND FALSE)
  string(CONCAT hiprand-fortran_NOT_FOUND_MESSAGE
      "The hipRAND Fortran bindings need Fortran enabled before find_package: "
      "add Fortran to your project() languages, or call enable_language(Fortran).")
  return()
endif()

if(DEFINED HIPRAND_FORTRAN_COMPILER_DIR)
  # The consumer chose the directory: use exactly that one.
  set(_hiprand_dir "${HIPRAND_FORTRAN_COMPILER_DIR}")
  if(NOT EXISTS "${_hiprand_incdir}/${_hiprand_dir}/hiprand.mod")
    file(GLOB _hiprand_avail RELATIVE "${_hiprand_incdir}"
         "${_hiprand_incdir}/*")
    set(hiprand-fortran_FOUND FALSE)
    string(CONCAT hiprand-fortran_NOT_FOUND_MESSAGE
        "HIPRAND_FORTRAN_COMPILER_DIR is '${_hiprand_dir}', but there is no "
        "${_hiprand_incdir}/${_hiprand_dir}/hiprand.mod. Available: "
        "${_hiprand_avail}.")
    return()
  endif()
else()
  # MUST match the mapping in projects/hiprand/fortran/CMakeLists.txt.
  if(CMAKE_Fortran_COMPILER_ID STREQUAL "GNU")
    set(_hiprand_fc "gfortran")
  elseif(CMAKE_Fortran_COMPILER_ID MATCHES "Flang")
    set(_hiprand_fc "amdflang")
  elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "Cray")
    set(_hiprand_fc "ftn")
  elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "IntelLLVM")
    set(_hiprand_fc "ifx")
  elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "Intel")
    set(_hiprand_fc "ifort")
  elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "NVHPC")
    set(_hiprand_fc "nvfortran")
  else()
    get_filename_component(_hiprand_fc "${CMAKE_Fortran_COMPILER}" NAME_WE)
    string(TOLOWER "${_hiprand_fc}" _hiprand_fc)
  endif()

  # Accepts FC or FC<sep>suffix (e.g. gfortran-13.3.0). Not a regex: FC can be
  # an arbitrary file name and CMake has no regex-escape.
  function(_hiprand_dir_matches DIR FC OUT)
    set(${OUT} FALSE PARENT_SCOPE)
    if(DIR STREQUAL FC)
      set(${OUT} TRUE PARENT_SCOPE)
      return()
    endif()
    string(LENGTH "${FC}" _n)
    string(LENGTH "${DIR}" _dn)
    if(_dn GREATER _n)
      string(SUBSTRING "${DIR}" 0 ${_n} _head)
      string(SUBSTRING "${DIR}" ${_n} 1 _sep)
      if(_head STREQUAL FC AND _sep MATCHES "^[-._]$")
        set(${OUT} TRUE PARENT_SCOPE)
      endif()
    endif()
  endfunction()

  # Prefer the consumer's own compiler; the built directory is only a fallback.
  set(_hiprand_dir "")
  if(EXISTS "${_hiprand_incdir}/${_hiprand_fc}/hiprand.mod")
    set(_hiprand_dir "${_hiprand_fc}")
  else()
    _hiprand_dir_matches("${_hiprand_built_dir}" "${_hiprand_fc}" _hiprand_ok)
    if(_hiprand_ok)
      set(_hiprand_dir "${_hiprand_built_dir}")
    endif()
  endif()

  if(NOT _hiprand_dir)
    file(GLOB _hiprand_avail RELATIVE "${_hiprand_incdir}"
         "${_hiprand_incdir}/*")
    set(hiprand-fortran_FOUND FALSE)
    string(CONCAT hiprand-fortran_NOT_FOUND_MESSAGE
        "This project builds with ${_hiprand_fc}, but no hiprand.mod for it is "
        "installed under ${_hiprand_incdir}. Available: "
        "${_hiprand_avail}. A Fortran .mod cannot be shared across compilers; "
        "rebuild the bindings with ${_hiprand_fc}, or set "
        "HIPRAND_FORTRAN_COMPILER_DIR to the directory to use.")
    return()
  endif()
endif()

# hip::hiprand must exist before the targets file is read. C is enabled because
# hip-config.cmake reaches FindThreads.
if(@HIPRAND_FORTRAN_NEEDS_C_PACKAGE@)
  if(NOT TARGET hip::hiprand)
    if(NOT CMAKE_C_COMPILER_LOADED AND NOT CMAKE_CXX_COMPILER_LOADED)
      enable_language(C)
    endif()
    include(CMakeFindDependencyMacro)
    find_dependency(hiprand)
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/hiprand-fortran-targets.cmake")

# The targets file hardcodes the built directory; repoint it if another was chosen.
if(NOT _hiprand_dir STREQUAL "${_hiprand_built_dir}")
  set_target_properties(hip::hiprand_fortran PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${_hiprand_incdir}/${_hiprand_dir}")
  get_target_property(_hiprand_cfgs hip::hiprand_fortran IMPORTED_CONFIGURATIONS)
  foreach(_hiprand_c IN LISTS _hiprand_cfgs)
    set_target_properties(hip::hiprand_fortran PROPERTIES
      IMPORTED_LOCATION_${_hiprand_c}
        "${_hiprand_libdir}/${_hiprand_dir}/libhiprand_fortran.a")
  endforeach()
endif()

set(hiprand_FORTRAN_FOUND TRUE)

check_required_components(hiprand-fortran)
