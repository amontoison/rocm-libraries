# Config package for the hipRAND Fortran bindings.
#
#   find_package(hiprand-fortran REQUIRED)
#   target_link_libraries(my_app PRIVATE hip::hiprand_fortran)
#
# The bindings ship as one archive and one .mod set PER FORTRAN COMPILER,
# because a .mod is not portable across compilers. This package checks that the
# consumer is building with the compiler the bindings were installed for, and
# fails with a named diagnostic rather than hitting an unreadable .mod later.

@PACKAGE_INIT@

set(HIPRAND_FORTRAN_COMPILER_DIR "@HIPRAND_FORTRAN_COMPILER_DIR@")

# Where the per-compiler subdirectories live. Written by PATH_VARS, so the
# preamble above has already turned each into an absolute path derived from
# where THIS file was found: the package survives relocation and gets lib64
# right. Do not name that preamble by its token here: it is substituted wherever
# it appears, comments included, so spelling it out would splice in a copy.
set(_hiprand_libdir "@PACKAGE_HIPRAND_FORTRAN_LIBDIR@")
set(_hiprand_incdir "@PACKAGE_HIPRAND_FORTRAN_INCLUDEDIR@")

# How a consumer asks "is a hipRAND Fortran binding available here?". Set
# whether this package is reached directly by find_package(hiprand-fortran) or
# alongside hiprand-config.cmake, with which it is co-installed in
# lib/cmake/hiprand. It stays FALSE on every early return below.
set(hiprand_FORTRAN_FOUND FALSE)

if(NOT CMAKE_Fortran_COMPILER_LOADED)
  set(hiprand-fortran_FOUND FALSE)
  # One argument, not several: set() with multiple arguments builds a LIST, and
  # find_package renders a list with a semicolon at every element boundary, so a
  # message split across lines would read "... find_package: ;add Fortran ...".
  string(CONCAT hiprand-fortran_NOT_FOUND_MESSAGE
      "The hipRAND Fortran bindings need Fortran enabled before find_package: "
      "add Fortran to your project() languages, or call enable_language(Fortran).")
  return()
endif()

# This MUST mirror the mapping in projects/hiprand/fortran/CMakeLists.txt
# exactly: it recomputes, for the compiler the CONSUMER is using, the same
# directory name the bindings were installed under. The two cannot share code --
# this file runs in a consumer's build, long after ours is gone -- so they are
# kept in step by hand. Get it wrong and the check can never match: the package
# then rejects every consumer over a mismatch that does not exist.
if(CMAKE_Fortran_COMPILER_ID STREQUAL "GNU")
  set(_hiprand_fc "gfortran")
elseif(CMAKE_Fortran_COMPILER_ID MATCHES "Flang")
  set(_hiprand_fc "amdflang")
elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "Cray")
  set(_hiprand_fc "ftn")
elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "IntelLLVM")
  set(_hiprand_fc "ifx")
elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "Intel")
  set(_hiprand_fc "ifort")
elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "NVHPC")
  set(_hiprand_fc "nvfortran")
else()
  get_filename_component(_hiprand_fc "${CMAKE_Fortran_COMPILER}" NAME_WE)
  string(TOLOWER "${_hiprand_fc}" _hiprand_fc)
endif()

# A site that installs several versions of one compiler side by side overrides
# HIPRAND_FORTRAN_COMPILER_DIR with a suffixed name (gfortran-13.3.0), so the
# recorded directory is accepted when it is the derived name, or that name
# followed by a separator and anything; strict equality would reject exactly the
# sites that used the documented override. The layout records no version, so
# gfortran 13 and gfortran 15 are indistinguishable here.
#
# Done by length and substring rather than regex: _hiprand_fc comes from the
# basename fallback above, so it is an arbitrary file name, and with no
# regex-escape in CMake a compiler called g++.wrapper or flang(2) would either
# mismatch silently or abort CMake with a regex error.
function(_hiprand_dir_matches DIR FC OUT)
  set(${OUT} FALSE PARENT_SCOPE)
  if(DIR STREQUAL FC)
    set(${OUT} TRUE PARENT_SCOPE)
    return()
  endif()
  string(LENGTH "${FC}" _n)
  string(LENGTH "${DIR}" _dn)
  if(_dn GREATER _n)
    string(SUBSTRING "${DIR}" 0 ${_n} _head)
    string(SUBSTRING "${DIR}" ${_n} 1 _sep)
    if(_head STREQUAL FC AND _sep MATCHES "^[-._]$")
      set(${OUT} TRUE PARENT_SCOPE)
    endif()
  endif()
endfunction()

# Which per-compiler directory to use. A prefix can hold artifacts for several
# compilers at once, but the config package is written once, so the recorded
# HIPRAND_FORTRAN_COMPILER_DIR names whichever install ran LAST and trusting it
# blindly rejects a consumer whose .mod is present. Prefer the consumer's OWN
# compiler when its artifacts are here, and fall back to the recorded value.
set(_hiprand_dir "")
if(EXISTS "${_hiprand_incdir}/${_hiprand_fc}/hiprand.mod")
  set(_hiprand_dir "${_hiprand_fc}")
else()
  _hiprand_dir_matches("${HIPRAND_FORTRAN_COMPILER_DIR}" "${_hiprand_fc}" _hiprand_ok)
  if(_hiprand_ok)
    set(_hiprand_dir "${HIPRAND_FORTRAN_COMPILER_DIR}")
  endif()
endif()

if(NOT _hiprand_dir)
  # Name what IS installed, so the reader can see whether they need to rebuild
  # or merely point at an existing directory.
  file(GLOB _hiprand_avail RELATIVE "${_hiprand_incdir}"
       "${_hiprand_incdir}/*")
  set(hiprand-fortran_FOUND FALSE)
  string(CONCAT hiprand-fortran_NOT_FOUND_MESSAGE
      "This project builds with ${_hiprand_fc}, but no hiprand.mod for it is "
      "installed under ${_hiprand_incdir}. Available: "
      "${_hiprand_avail}. A Fortran .mod cannot be shared across compilers; "
      "rebuild the bindings with ${_hiprand_fc}, or set "
      "HIPRAND_FORTRAN_COMPILER_DIR to the directory to use.")
  return()
endif()

# The C library the binding declares bind(C) interfaces into. It is a link-time
# dependency of the imported target, so it must be imported BEFORE the include()
# below, or hip::hiprand_fortran would point at an undefined hip::hiprand and
# the generate step would fail.
#
# hiprand-config.cmake in turn does find_dependency(hip), and hip-config.cmake
# reaches FindThreads, which hard-errors unless C or CXX is enabled. Enabling a
# language from a config package is unusual, and deliberate: the alternative is
# making every Fortran consumer write enable_language(C) after an error that
# names nothing they wrote.
#
# The outer guard is substituted to a literal TRUE or FALSE by the build that
# installed this file, and is FALSE when no hipRAND C library was in sight
# there. That build is legitimate -- a Fortran binding compiles against nothing
# -- and exports a target with an empty link interface, so requiring the
# consumer to find hipRAND would fail their configure over a package this one
# does not use. Such a consumer links -lhiprand itself.
if(@HIPRAND_FORTRAN_NEEDS_C_PACKAGE@)
  if(NOT TARGET hip::hiprand)
    if(NOT CMAKE_C_COMPILER_LOADED AND NOT CMAKE_CXX_COMPILER_LOADED)
      enable_language(C)
    endif()
    include(CMakeFindDependencyMacro)
    find_dependency(hiprand)
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/hiprand-fortran-targets.cmake")

# The targets file hardcodes the directory the package was BUILT with. When the
# consumer's compiler resolved to a different one above, repoint the imported
# target at it, otherwise the .mod found and the archive linked would disagree.
if(NOT _hiprand_dir STREQUAL "${HIPRAND_FORTRAN_COMPILER_DIR}")
  set_target_properties(hip::hiprand_fortran PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${_hiprand_incdir}/${_hiprand_dir}")
  get_target_property(_hiprand_cfgs hip::hiprand_fortran IMPORTED_CONFIGURATIONS)
  foreach(_hiprand_c IN LISTS _hiprand_cfgs)
    set_target_properties(hip::hiprand_fortran PROPERTIES
      IMPORTED_LOCATION_${_hiprand_c}
        "${_hiprand_libdir}/${_hiprand_dir}/libhiprand_fortran.a")
  endforeach()
endif()

set(hiprand_FORTRAN_FOUND TRUE)

check_required_components(hiprand-fortran)
