# Config package for the rocSOLVER Fortran bindings.
#
#   find_package(rocsolver-fortran REQUIRED)
#   target_link_libraries(my_app PRIVATE roc::rocsolver_fortran)
#
# The bindings ship as one archive and one .mod set PER FORTRAN COMPILER, since a
# .mod is not portable across compilers. This package checks that the consumer is
# building with the compiler the bindings were installed for, and fails with a
# named diagnostic rather than hitting an unreadable .mod much later.
#
# The rocSOLVER module is written on top of the rocBLAS one (`use rocblas`), so
# the rocBLAS Fortran package, built with the same compiler, is required too.

@PACKAGE_INIT@

set(ROCSOLVER_FORTRAN_COMPILER_DIR "@ROCSOLVER_FORTRAN_COMPILER_DIR@")

# Where the per-compiler subdirectories live. Written by PATH_VARS, so the
# preamble above has already turned each into an absolute path derived from where
# THIS file was found: relocatable, and lib64 where a distro uses it. Everything
# below goes through these two.
#
# Do not spell the preamble's token here: configure_package_config_file()
# substitutes it everywhere in the template, comments included.
set(_rocsolver_libdir "@PACKAGE_ROCSOLVER_FORTRAN_LIBDIR@")
set(_rocsolver_incdir "@PACKAGE_ROCSOLVER_FORTRAN_INCLUDEDIR@")

# A consumer asks "is a rocSOLVER Fortran binding available here?" through
# rocsolver_FORTRAN_FOUND, set whether this package is reached directly or
# alongside the co-installed rocsolver-config.cmake. It stays FALSE on every
# early return below.
set(rocsolver_FORTRAN_FOUND FALSE)

if(NOT CMAKE_Fortran_COMPILER_LOADED)
  set(rocsolver-fortran_FOUND FALSE)
  # string(CONCAT), not a multi-argument set(): that builds a LIST, and
  # find_package renders a list with a semicolon at every element boundary.
  string(CONCAT rocsolver-fortran_NOT_FOUND_MESSAGE
      "The rocSOLVER Fortran bindings need Fortran enabled before find_package: "
      "add Fortran to your project() languages, or call enable_language(Fortran).")
  return()
endif()

# MUST mirror the mapping in projects/rocsolver/fortran/CMakeLists.txt exactly:
# it recomputes, for the CONSUMER's compiler, the directory name the bindings
# were installed under. The two cannot share code -- this file runs in a
# consumer's build long after ours is gone -- so they are kept in step by hand.
# Get it wrong and the check never matches, rejecting every consumer with a
# compiler mismatch that does not exist.
if(CMAKE_Fortran_COMPILER_ID STREQUAL "GNU")
  set(_rocsolver_fc "gfortran")
elseif(CMAKE_Fortran_COMPILER_ID MATCHES "Flang")
  set(_rocsolver_fc "amdflang")
elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "Cray")
  set(_rocsolver_fc "ftn")
elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "IntelLLVM")
  set(_rocsolver_fc "ifx")
elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "Intel")
  set(_rocsolver_fc "ifort")
elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "NVHPC")
  set(_rocsolver_fc "nvfortran")
else()
  get_filename_component(_rocsolver_fc "${CMAKE_Fortran_COMPILER}" NAME_WE)
  string(TOLOWER "${_rocsolver_fc}" _rocsolver_fc)
endif()

# A site that installs several versions of one compiler overrides
# ROCSOLVER_FORTRAN_COMPILER_DIR with a suffixed name (gfortran-13.3.0), so
# accept the derived name, or that name followed by a separator and anything; a
# strict equality would reject exactly the sites that used the documented
# override. The layout records no version, so this cannot tell gfortran 13 from
# gfortran 15.
#
# By length and substring rather than regex: _rocsolver_fc can be an arbitrary
# file name from the fallback branch above, and CMake has no regex-escape, so a
# compiler called g++.wrapper or flang(2) would mismatch or abort the regex.
function(_rocsolver_dir_matches DIR FC OUT)
  set(${OUT} FALSE PARENT_SCOPE)
  if(DIR STREQUAL FC)
    set(${OUT} TRUE PARENT_SCOPE)
    return()
  endif()
  string(LENGTH "${FC}" _n)
  string(LENGTH "${DIR}" _dn)
  if(_dn GREATER _n)
    string(SUBSTRING "${DIR}" 0 ${_n} _head)
    string(SUBSTRING "${DIR}" ${_n} 1 _sep)
    if(_head STREQUAL FC AND _sep MATCHES "^[-._]$")
      set(${OUT} TRUE PARENT_SCOPE)
    endif()
  endif()
endfunction()

# Which per-compiler directory to use. The recorded
# ROCSOLVER_FORTRAN_COMPILER_DIR is only a default: a prefix can hold artifacts
# for several compilers, but the config package is written once, so the recorded
# value names whichever install ran last and trusting it blindly would reject a
# consumer whose .mod is present. Prefer the consumer's OWN compiler when its
# artifacts are installed here, and fall back to the recorded directory.
set(_rocsolver_dir "")
if(EXISTS "${_rocsolver_incdir}/${_rocsolver_fc}/rocsolver.mod")
  set(_rocsolver_dir "${_rocsolver_fc}")
else()
  _rocsolver_dir_matches("${ROCSOLVER_FORTRAN_COMPILER_DIR}" "${_rocsolver_fc}" _rocsolver_ok)
  if(_rocsolver_ok)
    set(_rocsolver_dir "${ROCSOLVER_FORTRAN_COMPILER_DIR}")
  endif()
endif()

if(NOT _rocsolver_dir)
  # Name what IS installed, so the reader can see whether they need to rebuild
  # or merely point at an existing directory.
  file(GLOB _rocsolver_avail RELATIVE "${_rocsolver_incdir}"
       "${_rocsolver_incdir}/*")
  set(rocsolver-fortran_FOUND FALSE)
  string(CONCAT rocsolver-fortran_NOT_FOUND_MESSAGE
      "This project builds with ${_rocsolver_fc}, but no rocsolver.mod for it is "
      "installed under ${_rocsolver_incdir}. Available: "
      "${_rocsolver_avail}. A Fortran .mod cannot be shared across compilers; "
      "rebuild the bindings with ${_rocsolver_fc}, or set "
      "ROCSOLVER_FORTRAN_COMPILER_DIR to the directory to use.")
  return()
endif()

# The C library the binding declares bind(C) interfaces into. A link-time
# dependency of the imported target, so it must be imported BEFORE the include()
# below or roc::rocsolver_fortran would point at an undefined roc::rocsolver and
# the generate step would fail.
#
# The outer condition is decided at configure time by fortran/CMakeLists.txt and
# records whether roc::rocsolver really is in the exported link interface: the
# bindings can be built with no rocSOLVER installed, and demanding the C package
# here would then fail for a dependency this package does not have.
#
# rocsolver-config.cmake does find_dependency(hip), and hip-config.cmake reaches
# FindThreads, which hard-errors unless C or CXX is enabled. Enabling a language
# from a config package is unusual and deliberate: the alternative is every
# Fortran consumer writing enable_language(C) after an error naming nothing they
# wrote.
if(@ROCSOLVER_FORTRAN_NEEDS_C_PACKAGE@)
  if(NOT TARGET roc::rocsolver)
    if(NOT CMAKE_C_COMPILER_LOADED AND NOT CMAKE_CXX_COMPILER_LOADED)
      enable_language(C)
    endif()
    include(CMakeFindDependencyMacro)
    find_dependency(rocsolver)
  endif()
endif()

# The rocBLAS BINDING, a different thing from the rocBLAS C library
# find_dependency(rocsolver) just pulled in. rocsolver.mod was compiled against
# rocblas.mod, so the consumer needs it on its include path; it arrives through
# the PUBLIC link recorded in the targets file, which must therefore be imported
# FIRST or the generate step fails on an undefined target.
#
# PATH_SUFFIXES lib/cmake/rocblas is where the real config sits, beside the C
# package; the forwarder covers the plain spelling. find_package rather than
# find_dependency, so the diagnostic below can name what is missing --
# find_dependency would report the rocSOLVER package itself as not found.
if(NOT TARGET roc::rocblas_fortran)
  find_package(rocblas-fortran QUIET CONFIG PATH_SUFFIXES lib/cmake/rocblas)
endif()
if(NOT TARGET roc::rocblas_fortran)
  set(rocsolver-fortran_FOUND FALSE)
  string(CONCAT rocsolver-fortran_NOT_FOUND_MESSAGE
      "The rocSOLVER Fortran bindings are built on the rocBLAS ones (`use "
      "rocblas`), but no rocBLAS Fortran package was found. Install it for "
      "${_rocsolver_fc} and make sure its prefix is on CMAKE_PREFIX_PATH.")
  return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/rocsolver-fortran-targets.cmake")

# The targets file hardcodes the directory the package was BUILT with. When the
# consumer's compiler resolved to a different one above, repoint the imported
# target at it, otherwise the .mod found and the archive linked would disagree.
if(NOT _rocsolver_dir STREQUAL "${ROCSOLVER_FORTRAN_COMPILER_DIR}")
  set_target_properties(roc::rocsolver_fortran PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${_rocsolver_incdir}/${_rocsolver_dir}")
  get_target_property(_rocsolver_cfgs roc::rocsolver_fortran IMPORTED_CONFIGURATIONS)
  foreach(_rocsolver_c IN LISTS _rocsolver_cfgs)
    set_target_properties(roc::rocsolver_fortran PROPERTIES
      IMPORTED_LOCATION_${_rocsolver_c}
        "${_rocsolver_libdir}/${_rocsolver_dir}/librocsolver_fortran.a")
  endforeach()
endif()

set(rocsolver_FORTRAN_FOUND TRUE)

check_required_components(rocsolver-fortran)
