# Config package for the rocSPARSE Fortran bindings.
#
#   find_package(rocsparse-fortran REQUIRED)
#   target_link_libraries(my_app PRIVATE roc::rocsparse_fortran)
#
# The bindings ship as one static archive and one .mod set PER FORTRAN COMPILER,
# because a .mod is portable across neither compilers nor versions of one
# compiler. This package checks that the consumer's compiler matches, and fails
# with a named diagnostic rather than hitting an unreadable .mod much later.

@PACKAGE_INIT@

set(ROCSPARSE_FORTRAN_COMPILER_DIR "@ROCSPARSE_FORTRAN_COMPILER_DIR@")

# Where the per-compiler subdirectories live. Written by PATH_VARS, so the
# PACKAGE_INIT block above has already turned each into an absolute path derived
# from where THIS file was found: the package survives relocation and gets lib64
# right. Everything below goes through these two.
#
# PACKAGE_INIT is named without its @ markers, and has to stay that way:
# configure_package_config_file() substitutes EVERY occurrence of the token,
# comments included, so spelling it in full would stamp a second copy of the
# whole boilerplate into the middle of the installed config.
set(_rocsparse_libdir "@PACKAGE_ROCSPARSE_FORTRAN_LIBDIR@")
set(_rocsparse_incdir "@PACKAGE_ROCSPARSE_FORTRAN_INCLUDEDIR@")

# A consumer asks "is a rocSPARSE Fortran binding available here?" through
# rocsparse_FORTRAN_FOUND, which is set whether this package is reached directly
# by find_package(rocsparse-fortran) or alongside rocsparse-config.cmake, with
# which it is co-installed in lib/cmake/rocsparse. It stays FALSE on every early
# return below.
set(rocsparse_FORTRAN_FOUND FALSE)

if(NOT CMAKE_Fortran_COMPILER_LOADED)
  set(rocsparse-fortran_FOUND FALSE)
  # One argument, not several: set() with several builds a LIST, and
  # find_package renders a list with a semicolon at every element boundary.
  string(CONCAT rocsparse-fortran_NOT_FOUND_MESSAGE
      "The rocSPARSE Fortran bindings need Fortran enabled before find_package: "
      "add Fortran to your project() languages, or call enable_language(Fortran).")
  return()
endif()

# This MUST mirror the mapping in projects/rocsparse/fortran/CMakeLists.txt: it
# recomputes, for the compiler the CONSUMER is using, the same directory name
# the bindings were installed under. The two cannot share code -- this file runs
# in a consumer's build, long after ours is gone -- so they are kept in step by
# hand. Get it wrong and the check can never match, and the package then rejects
# every consumer over a compiler mismatch that does not exist.
if(CMAKE_Fortran_COMPILER_ID STREQUAL "GNU")
  set(_rocsparse_fc "gfortran")
elseif(CMAKE_Fortran_COMPILER_ID MATCHES "Flang")
  set(_rocsparse_fc "amdflang")
elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "Cray")
  set(_rocsparse_fc "ftn")
elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "IntelLLVM")
  set(_rocsparse_fc "ifx")
elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "Intel")
  set(_rocsparse_fc "ifort")
elseif(CMAKE_Fortran_COMPILER_ID STREQUAL "NVHPC")
  set(_rocsparse_fc "nvfortran")
else()
  get_filename_component(_rocsparse_fc "${CMAKE_Fortran_COMPILER}" NAME_WE)
  string(TOLOWER "${_rocsparse_fc}" _rocsparse_fc)
endif()

# A site installing several versions of one compiler side by side overrides
# ROCSPARSE_FORTRAN_COMPILER_DIR with a suffixed name (gfortran-13.3.0), so
# accept the derived name, or that name followed by a separator and anything;
# strict equality would reject exactly the sites that used the documented
# override.
#
# By length and substring rather than regex: _rocsparse_fc can be an arbitrary
# basename on the fallback branch above, and CMake has no regex-escape, so a
# compiler called g++.wrapper or flang(2) would mismatch silently or abort.
function(_rocsparse_dir_matches DIR FC OUT)
  set(${OUT} FALSE PARENT_SCOPE)
  if(DIR STREQUAL FC)
    set(${OUT} TRUE PARENT_SCOPE)
    return()
  endif()
  string(LENGTH "${FC}" _n)
  string(LENGTH "${DIR}" _dn)
  if(_dn GREATER _n)
    string(SUBSTRING "${DIR}" 0 ${_n} _head)
    string(SUBSTRING "${DIR}" ${_n} 1 _sep)
    if(_head STREQUAL FC AND _sep MATCHES "^[-._]$")
      set(${OUT} TRUE PARENT_SCOPE)
    endif()
  endif()
endfunction()

# Which per-compiler directory to use. The recorded
# ROCSPARSE_FORTRAN_COMPILER_DIR is only a default: a prefix can hold artifacts
# for several compilers at once, while the config package is written once and
# names whichever install ran last, so trusting it blindly would reject a
# consumer whose .mod is present. Prefer the consumer's OWN compiler when its
# artifacts are installed here, and fall back to the recorded directory.
set(_rocsparse_dir "")
if(EXISTS "${_rocsparse_incdir}/${_rocsparse_fc}/rocsparse.mod")
  set(_rocsparse_dir "${_rocsparse_fc}")
else()
  _rocsparse_dir_matches("${ROCSPARSE_FORTRAN_COMPILER_DIR}" "${_rocsparse_fc}" _rocsparse_ok)
  if(_rocsparse_ok)
    set(_rocsparse_dir "${ROCSPARSE_FORTRAN_COMPILER_DIR}")
  endif()
endif()

if(NOT _rocsparse_dir)
  # Name what IS installed, so the reader can see whether they need to rebuild
  # or merely point at an existing directory.
  file(GLOB _rocsparse_avail RELATIVE "${_rocsparse_incdir}"
       "${_rocsparse_incdir}/*")
  set(rocsparse-fortran_FOUND FALSE)
  string(CONCAT rocsparse-fortran_NOT_FOUND_MESSAGE
      "This project builds with ${_rocsparse_fc}, but no rocsparse.mod for it is "
      "installed under ${_rocsparse_incdir}. Available: "
      "${_rocsparse_avail}. A Fortran .mod cannot be shared across compilers; "
      "rebuild the bindings with ${_rocsparse_fc}, or set "
      "ROCSPARSE_FORTRAN_COMPILER_DIR to the directory to use.")
  return()
endif()

# The C library the binding declares bind(C) interfaces into: a link-time
# dependency of the imported target, so it must be imported before the include()
# below, or roc::rocsparse_fortran would point at an undefined roc::rocsparse.
#
# The outer guard is substituted as a literal TRUE or FALSE by the build, TRUE
# only when roc::rocsparse really is in the archive's link interface: the
# bindings compile against nothing, so they can be built on a machine with no
# rocSPARSE installed, and demanding the C package then would fail a build that
# has no problem.
#
# rocsparse-config.cmake does find_dependency(hip), whose hip-config.cmake
# reaches FindThreads and hard-errors unless C or CXX is enabled. Enabling a
# language from a config package is unusual and deliberate: the alternative is
# every Fortran consumer writing enable_language(C) after an error naming
# nothing of theirs.
if(@ROCSPARSE_FORTRAN_NEEDS_C_PACKAGE@)
  if(NOT TARGET roc::rocsparse)
    if(NOT CMAKE_C_COMPILER_LOADED AND NOT CMAKE_CXX_COMPILER_LOADED)
      enable_language(C)
    endif()
    include(CMakeFindDependencyMacro)
    find_dependency(rocsparse)
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/rocsparse-fortran-targets.cmake")

# The targets file hardcodes the directory the package was BUILT with. When the
# consumer's compiler resolved to a different one above, repoint the imported
# target at it, otherwise the .mod found and the archive linked would disagree.
if(NOT _rocsparse_dir STREQUAL "${ROCSPARSE_FORTRAN_COMPILER_DIR}")
  set_target_properties(roc::rocsparse_fortran PROPERTIES
    INTERFACE_INCLUDE_DIRECTORIES "${_rocsparse_incdir}/${_rocsparse_dir}")
  get_target_property(_rocsparse_cfgs roc::rocsparse_fortran IMPORTED_CONFIGURATIONS)
  foreach(_rocsparse_c IN LISTS _rocsparse_cfgs)
    set_target_properties(roc::rocsparse_fortran PROPERTIES
      IMPORTED_LOCATION_${_rocsparse_c}
        "${_rocsparse_libdir}/${_rocsparse_dir}/librocsparse_fortran.a")
  endforeach()
endif()

set(rocsparse_FORTRAN_FOUND TRUE)

check_required_components(rocsparse-fortran)
